@startuml 
title Gestión de empresas cliente
left to right direction
:Administrador: as ADM
:Superadministrador: as SADM
:Usuario responsable: as RESP


rectangle "Sistema Turbine" as SistemaTurbine {
 (Registrar empresa\ncliente) as UC4
 UC4 ..>(Introducir datos\nde la empresa) :Include
 UC4 ..>(Validar campos\nobligatorios) : Include
 UC4 ..>(Almacenar cliente y\nregistrar la acción) : Include
 UC4<.down.(Ofrecer reactivar cliente\neliminado):Extend
 (Validar campos\nobligatorios)<..(Excepcion si datos fiscales incompletos\no inválidos):Extend

 (Importar clientes\nmediante CSV) as UC5
 UC5 ..>(Analizar y validar\nfilas del CSV) : Include
 UC5 ..>(Crear fichas de\nempresas) :Include
 UC5 ..>(Registrar la operación) : Include
 UC5 <..(Rechazar archivo que\nno es CSV) : Extend
 (Analizar y validar\nfilas del CSV)<..(Señalar la fila con\nerror):Extend

 (Editar personas de contacto\nde cliente) as UC6
 UC6 ..>(Añadir, modificar o\neliminar contacto):Include
 UC6 ..>(Validar y registrar\nla operación):Include
 (Añadir, modificar o\neliminar contacto)<..(Notificar error: empresa\nsin contactos) :Extend

 (Editar parámetros de\nfacturación de cliente) as UC7
 UC7 ..>(Modificar importes y frecuencia\nde recordatorios de pago):Include
 UC7 ..>(Aplicar parámetros, actualizar\nsuscripción y registrar):Include
 (Modificar importes y frecuencia\nde recordatorios de pago)<..(Rechazar importe o formato\nno válido):Extend

 (Aplicar descuentos o\npruebas gratuitas) as UC8
 UC8 ..>(Introducir porcentaje y\nfecha de caducidad):Include
 UC8 ..>(Aplicar parámetros y\nregistrar modificaciones):Include
 (Introducir porcentaje y\nfecha de caducidad)<..(Rechazar fecha o porcentaje\nerróneos):Extend

 (Validar cambios de facturación\nde gran tamaño) as UC9
 UC9 ..>(Mostrar diferencia\nde facturación):Include
 UC9 ..>(Modificar el cambio\nde plan):Include
 UC9 ..>(Aplicar cambio y registrar\nmodificaciones):Include
 

 (Eliminar una empresa\ncliente) as UC10
 UC10 ..>(Mostrar advertencia):Include
 UC10 ..>(Confirmar la eliminación):Include
 UC10 ..>(Borrar datos, conservar facturas\ny registrar modificaciones):Include
 
}
note left of UC4 :El Administrador ha iniciado sesión\n en el sistema
note left of UC5 :El Administrador ha iniciado\n sesión en el sistema y dispone\n del .csv para realizar el alta de la empresa
note left of UC6 :El Usuario responsable ha iniciado sesión\n en el sistema y tiene permisos \npara editar la ficha de la empresa cliente
note left of UC7 :El Administrador ha iniciado sesión\n en el sistema y existe el cliente en el sistema
note left of UC8 :El Administrador ha iniciado sesión en el sistema\n y la empresa cliente está registrada
note left of UC9 : El Superadministrador ha iniciado sesión en el sistema,\n la empresa cliente está registrada y tiene una notificación\n de revisión de cambio de factura
note left of UC10 : El Administrador ha iniciado sesión\n y la empresa cliente está registrada como activa
ADM  --> UC4
ADM  --> UC5
RESP --> UC6
ADM  --> UC7
ADM  --> UC8
SADM --> UC9
ADM  --> UC10




@enduml
