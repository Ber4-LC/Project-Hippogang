@startuml 
title Gestión de empresas cliente
left to right direction

:Usuario responsable: as RESP
:Administrador: as ADM
:Superadministrador: as SADM

rectangle "Sistema Turbine" as SistemaTurbine {
 (Consultar panel\nde control) as UC17
 UC17 ..>(Mostrar incidencias\npendientes de atender):Include
 UC17 ..>(Mostrar la incidencia seleccionada\npara revisarla):Include

 (Gestionar notificaciones\ninternas) as UC18
 UC18 ..>(Revisar bandeja de\nnotificaciones):Include
 UC18 ..>(Marcar notificación\ncomo resuelta):Include
 UC18 ..>(Actualizar estado y retirar de\nla lista de pendientes):Include

 (Consultar y filtrar informes\nfinancieros) as UC19
 UC19 ..>(Mostrar informes mensuales,\ntrimestrales y anuales):Include
 UC19 ..>(Filtrar informes [cliente, periodo,\nresponsable, país, estado y\ntipo de factura]):Include
 UC19 ..>(Mostrar informes con\nlos filtros aplicados):Include

 (Revisión de historiales y\ncopias de seguridad) as UC20
 UC20 ..>(Filtrar la vista\na revisar):Include
 UC20 ..>(Mostrar registros detallados):Include
 UC20 ..>(Generar copia de seguridad\no descargar archivos):IInclude
 (Filtrar la vista\na revisar)<..(Rechazar filtros\nerróneos):Extent

 (Edición de la tabla de\nprecios recurrentes) as UC21
 UC21 ..>(Modificar rangos\nde precios):Include
 UC21 ..>(Validar coherencia\nde los rangos):Include
 UC21 ..>(Confirmar cambios y actualizar\ntabla de referencia):Include
 UC21 <..(Rechazar solapamiento o error\nde formato):Extent



}

RESP -- UC17
RESP -- UC18
ADM  -- UC19
SADM -- UC20
SADM -- UC21

note left of UC17 : Precondicion el usuario ha iniciado sesión.
note left of UC18 : Precondicion el usuario ha iniciado sesión y tiene\nnotificaciones pendientes.
note left of UC19 : Precondicion el administrador ha iniciado sesión.
note left of UC20 : Precondicion el superadministrador ha iniciado sesión.
note left of UC21 : Precondicion  el superadministrador ha iniciado sesión.

@enduml
