@startuml
skinparam classAttributeIconSize 0



' =========================================================
' EMPRESAS
' =========================================================

class EmpresaCliente {
    - idEmpresa : int
    - nombreComercial : String
    - razonSocial : String
    - nif : String
    - domicilioFiscal : String
    - pais : String
    - monedaTrabajo : String
    - sector : String
    - fechaAlta : Date
    - activa : boolean
    - personasDeContacto: List<Contacto>
    - configuracionRecordatorios: ConfiguracionRecordatorios
    - plantillaFacturacion : Plantilla

    + agregarComentario(usuario: Usuario, contenido: String): Comentario
    + obtenerComentarios() : List<Comentario>
    + agregarIncidencia(autor: Usuario, responsable: Usuario, contenido: String, prioridad: PrioridadIncidencia): Incidencia
    + obtenerIncidencias() : List<Incidencia>

    + eliminarPersonaDeContacto(idAntiguo: int)
    + añadirPersonaDeContacto(nombre: String, email: String, telefono: String, idioma: String, comunicacionAdmin: boolean)
    + editarPersonaDeContacto(idAntiguo: int, nombre: String, email: String, telefono: String, idioma: String, comunicacionAdmin: boolean)

    + editarFrecuenciaRecordatorios()
    + editarDatosFiscales()
    + datosFiscalesCompletos() : boolean

    + darDeBaja()
    + reactivar()
}


class EmpresaManager <<Singleton>> {
    {static} - instancia : EmpresaManager

   
    {static} + getInstancia() : EmpresaManager
    + registrarEmpresa(empresa : EmpresaCliente) : EmpresaCliente
    + buscarDuplicados(empresa : EmpresaCliente) : List<EmpresaCliente>
    + darDeBaja(empresa : EmpresaCliente)
    + reactivarEmpresa(empresa : EmpresaCliente)
}


class Contacto {
    - idContacto : int
    - nombre : String
    - email : String
    - telefono : String
    - idioma : String
    - admiteComunicacionesAdministrativas : boolean
}

class Suscripcion {
    - idSuscripcion : int
    - importeRecurrente : Decimal
    - estado : EstadoSuscripcion
    - fechaInicio : Date
    - descuento : Decimal
    - fechaFinDescuento : Date

    + modificarImporte(nuevoImporte : Decimal)
    + aplicarDescuento(descuento : Decimal, diasPeriodo: int)
}


enum EstadoSuscripcion {
    ACTIVA
    PAUSADA
    CANCELADA
}


class SuscripcionManager <<Singleton>> {
    {static} - instancia: SuscripcionManager
    
    {static} + getInstancia: SuscripcionManager
    + generarFacturasMensuales()
    + revisarPreciosAnuales()
}


class ImportadorCSV {
    + validarArchivo(archivo : File) : boolean
    + generarVistaPrevia(archivo : File)
    + importarEmpresa(archivo: File)
    + importarEmpresas(archivo : File) : List<EmpresaCliente>
}


' =========================================================
' TABLA DE PRECIOS
' =========================================================


' =========================================================
' FACTURAS
' =========================================================

class FacturaManager <<Singleton>>{
    {static} - instancia: FacturaManager

    {static} + getInstancia: FacturaManager

    + crearFacturaRecurrente(empresa : EmpresaCliente, suscripcion : Suscripcion) : Factura
    + crearFacturaInicialProrrateada(empresa : EmpresaCliente, suscripcion : Suscripcion, fechaAlta : Date) : Factura
    + crearFacturaAdicional(empresa: EmpresaCliente, importe: Decimal, programarProximoMes : boolean) : Factura

    + validarFactura(factura : Factura) : boolean
    + buscarFacturasProgramadas(empresa : EmpresaCliente) : List<Factura>
    + filtrarFacturas(estado : EstadoFactura, fechaInicio : Date, fechaFin : Date, tipo : TipoFactura) : List<Factura>
}

class ConceptoFactura {
    - descripcion : String
    - importe : Decimal
}

class ArchivoAdjunto {
    - idArchivo : int
    - nombre : String
    - tipo : String
    - referenciaArchivo : String
    - fechaSubida : Date
}


class Factura {
    - idFactura : int
    - empresa : EmpresaCliente
    - fechaEmision : Date
    - fechaVencimiento : Date
    - importe : Decimal
    - moneda : String
    - estado : EstadoFactura
    - tipo : TipoFactura
    - conceptos : List<ConceptoFactura>
    - archivos : List<ArchivoAdjunto>
    - recordatoriosPausados : boolean
    - programadaProximoMes : boolean

    + condonarDeuda(justificacion : String)
    + descargarFactura()
    + guardarBorrador()
    + pausarRecordatorios()
    + reanudarRecordatorios()
}


enum EstadoFactura {
    BORRADOR
    EMITIDA
    IMPAGADA
    PAGADA
    CONDONADA
    CANCELADA
}

enum TipoFactura {
    RECURRENTE
    ADICIONAL
}


' =========================================================
' USUARIOS Y AUTENTICACION
' =========================================================

class Usuario {
    - idUsuario : int
    - nombre : String
    - email : String
    - passwordHash : String
    - activo : boolean
    - rol : RolUsuario
    - acceso: List<EmpresaCliente>

    + darAcceso(empresa: EmpresaCliente)
    + quitarAcceso(empresa: EmpresaCliente)
    + darAccesoTemporal(empresa: EmpresaCliente, dias: int)
    + activar()
    + desactivar()
}

enum RolUsuario {
    RESPONSABLE
    ADMIN
    SUPERADMIN
}

class Sesion {
    - idSesion : String
    - fechaInicio : DateTime
    - ultimaActividad : DateTime
    - activa : boolean
    - usuario : Usuario

    + actualizarActividad()
    + cerrar()
}

class AutenticacionManager <<Singleton>> {
    {static} - instancia : AutenticacionManager

    {static} + getInstancia() : AutenticacionManager

    + iniciarSesion(email : String, password : String) : Sesion
    + cerrarSesion(sesion : Sesion)
    + invalidarSesiones(usuario : Usuario)
    + validarDominioCorporativo(email : String) : boolean
}


' =========================================================
' PAGOS
' =========================================================

class Pago {
    - idPago : int
    - importe : Decimal
    - fecha : DateTime
    - estado : EstadoPago
    - referencia: String
    - origen : String
    - factura : Factura
}

enum EstadoPago {
    CONFIRMADO
    REQUIERE_CONCILIACION
}

class PagoManager <<Singleton>>{
    {static} - instancia: PagoManager

    {static} + getInstancia(): PagoManager
    + sincronizarPagos()
    + registrarPago(importe : Decimal, referencia : String, origen: String) : Pago
    + validarPago(pago : Pago) : EstadoPago
    + confirmarPago(pago : Pago)
}

interface ServicioPagos {
    + obtenerPagos() : List<Pago>
}


' =========================================================
' COMENTARIOS E INCIDENCIAS
' =========================================================

class Comentario {
    - idComentario : int
    - contenido : String
    - fecha : DateTime
    - tipo : TipoComentario
    - autor : Usuario
    - mencionados : List<Usuario>
    - empresa: EmpresaCliente


    + obtenerMencionados() : List<Usuario>
    + notificarMencionados(mencionados: List<Usuario>)
}

enum TipoComentario {
    NORMAL
    NOTA_ADMINISTRATIVA
}


class Incidencia {
    - idIncidencia : int
    - contenido : String
    - fecha : DateTime
    - estado: EstadoIncidencia
    - autor : Usuario
    - responsable: Usuario
    - prioridad: PrioridadIncidencia
    - empresa: EmpresaCliente
    - comentarios : List<Comentario>

    + cambiarEstado(estadoNuevo: EstadoIncidencia)
    + cambiarPrioridad(prioridadNueva : PrioridadIncidencia)
    + agregarComentario(comentario : Comentario)
}

enum EstadoIncidencia {
    ABIERTA
    EN_PROCESO
    SOLUCIONADA
}

enum PrioridadIncidencia {
    BAJA
    MEDIA
    ALTA
}


' =========================================================
' NOTIFICACIONES
' =========================================================

class Notificacion {
    - idNotificacion : int
    - mensaje : String
    - fecha : DateTime
    - leida : boolean
    - resuelta : boolean
    - destinatario : Usuario

    + marcarLeida()
    + marcarResuelta()
    + abrirOrigen()
}

class NotificacionManager <<Singleton>> {
    {static} - instancia: NotificacionManager
    
    {static} + getInstancia: NotificacionManager
    + crearNotificacion(destinatario : Usuario, mensaje : String) : Notificacion
    + filtrarNotificaciones(leida : boolean, resuelta : boolean) : List<Notificacion>
}


' =========================================================
' MENSAJES
' =========================================================

class Plantilla {
    - idPlantilla : int
    - nombre : String
    - asunto : String
    - contenido : String
    - idioma: String

    + editar(asunto : String, contenido : String, idioma : String)
}

class Mensaje {
    - idMensaje : int
    - empresa: EmpresaCliente
    - destinatarios: List<Contacto>
    - destinatariosEnvio : List<String>
    - fechaEnvio : DateTime
    - tipo: TipoMensaje
    - estado : EstadoMensaje
    - plantilla : Plantilla
    - facturas: List<Factura>

    + enviarMensaje()
}

enum EstadoMensaje {
    EN_COLA
    ENVIADO
    ENTREGADO
    FALLIDO
    REINTENTADO
}

enum TipoMensaje {
    FACTURA_ADICIONAL
    FACTURA_RECURRENTE
    RECORDATORIO
    CONFIRMACION_PAGO
    AVISO_CAMBIO_PRECIOS
    OTRO
}

class MensajeManager <<Singleton>> {
    {static} - instancia: MensajeManager
    
    {static} + getInstancia: MensajeManager
    + crearMensaje(empresa: EmpresaCliente, tipo: TipoMensaje, plantilla: Plantilla, factura: Factura) : Mensaje
    + generarRecordatoriosPendientes()
}

class ConfiguracionRecordatorios {
    - diasIniciales : List<int>
    - frecuenciaPosteriorDias : int
}


' =========================================================
' APROBACIONES
' =========================================================

class SolicitudAprobacion {
    - idSolicitud : int
    - fechaSolicitud : DateTime
    - descripcion : String
    - importe : Decimal
    - estado : EstadoAprobacion
    - aprobadoPor: Usuario
    - empresa : EmpresaCliente
    - comentarioResolucion : String
    
    + crearSolicitud
    + aprobar(aprobador : Usuario, comentario : String)
    + rechazar(aprobador : Usuario, comentario : String)
}

enum EstadoAprobacion {
    PENDIENTE
    APROBADA
    RECHAZADA
}

class AprobacionManager <<Singleton>> {
    {static} - instancia: AprobacionManager
    
    {static} + getInstancia: AprobacionManager
    + requiereAprobacion(importe : Decimal) : boolean
    + crearSolicitud(solicitante : Usuario, empresa : EmpresaCliente, importe : Decimal, descripcion : String) : SolicitudAprobacion
    + obtenerPendientes() : List<SolicitudAprobacion>
}


' =========================================================
' PERIODOS ECONOMICOS Y GESTORIA
' =========================================================

class PeriodoEconomico {
    - idPeriodo : int
    - fechaInicio : Date
    - fechaFin : Date
    - tipo : TipoPeriodo
    - estado : EstadoPeriodo
    - fechaCierre : DateTime

    - objetivoRecaudacion : Decimal
    - totalFacturado : Decimal
    - totalRecaudado : Decimal
    - totalPendiente : Decimal
    
    + calcularTotales()
    + calcularProgresoObjetivo() : Decimal
    + configurarObjetivo(importe : Decimal)

    + cerrar()
    + estaCerrado() : boolean
}

enum EstadoPeriodo {
    ABIERTO
    CERRADO
}

enum TipoPeriodo {
    MENSUAL
    TRIMESTRAL
    ANUAL
}

class PaqueteGestoria {
    - idPaquete : int
    - formato : String
    - fechaGeneracion : DateTime
    - referenciaArchivo : String
    - periodo : PeriodoEconomico
}

class PeriodoEconomicoManager <<Singleton>> {
    {static} - instancia: PeriodoEconomicoManager
    
    {static} + getInstancia: PeriodoEconomicoManager

    + obtenerPeriodo(fechaInicio : Date, tipo: TipoPeriodo) : PeriodoEconomico
    + validarCierre(periodo : PeriodoEconomico) : boolean
    + cerrarPeriodo(periodo : PeriodoEconomico, formato : String) : PaqueteGestoria
    + realizarModificacionExcepcional(periodo : PeriodoEconomico, justificacion : String)
    + generarInformePeriodoPersonalizado(fechaInicio: Date, fechaFin: Date)
}


' =========================================================
' AUDITORIA E HISTORIAL
' =========================================================

class RegistroAccion {
    - idRegistro : int
    - fecha : DateTime
    - accion : String
    - resultado : String
    - detalles : String
    - entidadAfectada : String
    - idEntidad : String
    - automatico : boolean
    - reversible : boolean
    - usuario : Usuario
}

class AuditoriaManager <<Singleton>> {
    {static} - instancia: AuditoriaManager
    
    {static} + getInstancia: AuditoriaManager
    + registrarAccion(accion : String, usuario : Usuario, resultado : String, detalles : String) : RegistroAccion
    + registrarProcesoAutomatico(accion : String, resultado : String, detalles : String) : RegistroAccion
    + filtrarHistorial(fechaInicio : Date, fechaFin : Date, usuario : Usuario) : List<RegistroAccion>
    + revertirAccion(registro : RegistroAccion) : boolean
}


' =========================================================
' COPIAS DE SEGURIDAD
' =========================================================

class CopiaSeguridad {
    - idCopia : int
    - fecha : DateTime
    - referenciaArchivo : String
    - estado : EstadoCopiaSeguridad
}

enum EstadoCopiaSeguridad {
    GENERANDO
    DISPONIBLE
    FALLIDA
}

class CopiaSeguridadManager <<Singleton>> {
    {static} - instancia: CopiaSeguridadManager
    
    {static} + getInstancia: CopiaSeguridadManager
    + generarCopia() : CopiaSeguridad
    + restaurarCopia(copia : CopiaSeguridad)
    + listarCopias() : List<CopiaSeguridad>
}


' =========================================================
' CONFIGURACION
' =========================================================

class ConfiguracionSistema <<Singleton>>{
    {static} instancia: ConfiguracionSistema

    - recordatoriosPorDefecto : ConfiguracionRecordatorios
    - tablaPrecios : TablaPrecios
    
    {static} + getInstancia(): ConfiguracionSistema 
    + configurarRecordatoriosPorDefecto()
    + editarTablaDePrecios()
}

class TablaPrecios {
    - rangos : List<RangoPrecio>

    + obtenerPrecio(ingresos : Decimal) : Decimal
    + validarRangos() : boolean
}

class RangoPrecio {
    - ingresoMinimo : Decimal
    - ingresoMaximo : Decimal
    - precioMensual : Decimal
}



' =========================================================
' RELACIONES - EMPRESAS Y SUSCRIPCIONES
' =========================================================

EmpresaCliente "1" -- "1" Suscripcion : suscripcion
EmpresaCliente "1" -- "0..*" Contacto : personasDeContacto
EmpresaCliente "1" --> "1" ConfiguracionRecordatorios : recordatorios
EmpresaCliente "0..*" --> "0..1" Plantilla : plantillaFacturacion

EmpresaManager ..> EmpresaCliente : gestiona
EmpresaManager ..> FacturaManager : genera primera factura
ImportadorCSV ..> EmpresaManager : usa

Suscripcion --> EstadoSuscripcion : estado
SuscripcionManager ..> Suscripcion : usa
SuscripcionManager ..> TablaPrecios : consulta
SuscripcionManager ..> FacturaManager : usa


' =========================================================
' RELACIONES - FACTURAS
' =========================================================

Factura "0..*" --> "1" EmpresaCliente : empresa
Factura --> EstadoFactura : estado
Factura --> TipoFactura : tipo
Factura "1" --> "1..*" ConceptoFactura : conceptos
Factura "1" --> "0..*" ArchivoAdjunto : archivos

FacturaManager ..> Factura : <<create>>
FacturaManager ..> MensajeManager : llama al crear


' =========================================================
' RELACIONES - USUARIOS Y AUTENTICACION
' =========================================================

Usuario --> RolUsuario : rol
Usuario "0..*" --> "0..*" EmpresaCliente : acceso

Sesion "0..*" --> "1" Usuario : usuario
AutenticacionManager ..> Usuario : autentica
AutenticacionManager ..> Sesion : gestiona


' =========================================================
' RELACIONES - PAGOS
' =========================================================

Pago "0..*" --> "0..1" Factura : factura
Pago --> EstadoPago : estado

PagoManager ..> Pago : gestiona
PagoManager ..> Factura : actualiza
PagoManager ..> MensajeManager : envia confirmacion
PagoManager ..> NotificacionManager : avisa conciliacion
PagoManager ..> ServicioPagos : consulta


' =========================================================
' RELACIONES - COMENTARIOS, INCIDENCIAS Y NOTIFICACIONES
' =========================================================

Comentario "0..*" --> "1" Usuario : autor
Comentario "0..*" --> "0..*" Usuario : mencionados
Comentario --> TipoComentario : tipo
Comentario "0..*" --> "1" EmpresaCliente : empresa
Comentario "1" --> "0..*" Notificacion : crea

Incidencia "0..*" --> "1" Usuario : autor
Incidencia "0..*" --> "1" Usuario : responsable
Incidencia "0..*" --> "1" EmpresaCliente : empresa
Incidencia --> EstadoIncidencia : estado
Incidencia --> PrioridadIncidencia : prioridad
Incidencia "1" --> "0..*" Comentario : comentarios

Notificacion "0..*" --> "1" Usuario : destinatario
NotificacionManager ..> Notificacion : gestiona


' =========================================================
' RELACIONES - MENSAJES
' =========================================================

Mensaje "0..*" --> "1" EmpresaCliente : empresa
Mensaje "0..*" --> "1..*" Contacto : destinatarios
Mensaje "0..*" --> "0..*" Factura : facturas
Mensaje --> EstadoMensaje : estado
Mensaje --> TipoMensaje : tipo
Mensaje "0..*" --> "1" Plantilla : plantilla

MensajeManager ..> Mensaje : crea


' =========================================================
' RELACIONES - CONFIGURACION Y PRECIOS
' =========================================================

ConfiguracionSistema "1" --> "1" ConfiguracionRecordatorios : recordatoriosPorDefecto
ConfiguracionSistema "1" --> "1" TablaPrecios : tablaPrecios
TablaPrecios "1" --> "1..*" RangoPrecio : rangos


' =========================================================
' RELACIONES - APROBACIONES
' =========================================================

SolicitudAprobacion --> EstadoAprobacion : estado
SolicitudAprobacion "0..*" --> "0..1" Usuario : aprobador
SolicitudAprobacion "0..*" --> "1" EmpresaCliente : empresa

AprobacionManager ..> SolicitudAprobacion : gestiona
SuscripcionManager ..> AprobacionManager : validacion humana


' =========================================================
' RELACIONES - PERIODOS ECONOMICOS
' =========================================================

PeriodoEconomico --> EstadoPeriodo : estado
PeriodoEconomico --> TipoPeriodo : tipo
PaqueteGestoria "0..*" --> "1" PeriodoEconomico : periodo

PeriodoEconomicoManager ..> PeriodoEconomico : gestiona
PeriodoEconomicoManager ..> PaqueteGestoria : genera


' =========================================================
' RELACIONES - AUDITORIA Y COPIAS
' =========================================================

RegistroAccion "0..*" --> "0..1" Usuario : usuario
AuditoriaManager ..> RegistroAccion : gestiona

CopiaSeguridad --> EstadoCopiaSeguridad : estado
CopiaSeguridadManager ..> CopiaSeguridad : gestiona


@enduml
